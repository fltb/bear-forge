  "laws": [
    {
      "id": "core",
      "claim": "Instance is the sole complete state machine; fork and restore return independent same-type instances under state-closure and execution assumptions.",
      "status": "conditional",
      "assumptions": [
        "Admitted program preserves TS semantics; inner mutable state is complete and isolated.",
        "GameContract handlers are pure and value-isolated; program/contract pairing is correct.",
        "Provider enforces lifecycle, exclusive binding and fork/restore laws in docs/protocol.md.",
        "Callback driving obeys lease, explicit reply/pause, cancellation, late-return and boundary rules; host bindings are not snapshotted."
      ],
      "argument": "evidence/C01/boundary-migration-review.md",
      "evidence": [
        "tests/contracts/instance-types.ts",
        "docs/protocol.md"
      ],
      "openObligations": [
        "Production controlled executor, continuation fork/save/restore and capability rebinding remain C02 obligations.",
        "Production binder ownership, lifecycle/failure isolation and real native/controlled differential execution remain unimplemented.",
        "Runtime callback/manual equivalence, driver ownership, cancellation races and event retry behavior require actual provider conformance tests."
      ]
    },
    {
      "id": "game",
      "claim": "BaseGame reads and drives its bound Instance; same-type fork and InstanceSnapshot save introduce no second transition engine.",
      "status": "conditional",
      "assumptions": [
        "Admitted program preserves TS semantics; inner mutable state is complete and isolated.",
        "GameContract handlers are pure and value-isolated; program/contract pairing is correct.",
        "Provider enforces lifecycle, exclusive binding and fork/restore laws in docs/protocol.md.",
        "Callback driving obeys lease, explicit reply/pause, cancellation, late-return and boundary rules; host bindings are not snapshotted."
      ],
      "argument": "evidence/C01/boundary-migration-review.md",
      "evidence": [
        "tests/contracts/basegame-types.ts",
        "docs/protocol.md"
      ],
      "openObligations": [
        "Production controlled executor, continuation fork/save/restore and capability rebinding remain C02 obligations.",
        "Production binder ownership, lifecycle/failure isolation and real native/controlled differential execution remain unimplemented.",
        "Runtime callback/manual equivalence, driver ownership, cancellation races and event retry behavior require actual provider conformance tests."
      ]
    },
    {
      "id": "authoring",
      "claim": "GameModule joins inner program/SDK and pure shared GameContract; all continuation-relevant mutable state lives inside Instance.",
      "status": "conditional",
      "assumptions": [
        "Admitted program preserves TS semantics; inner mutable state is complete and isolated.",
        "GameContract handlers are pure and value-isolated; program/contract pairing is correct.",
        "Provider enforces lifecycle, exclusive binding and fork/restore laws in docs/protocol.md.",
        "Callback driving obeys lease, explicit reply/pause, cancellation, late-return and boundary rules; host bindings are not snapshotted."
      ],
      "argument": "evidence/C01/boundary-migration-review.md",
      "evidence": [
        "tests/doudizhu/game.test.ts",
        "docs/protocol.md"
      ],
      "openObligations": [
        "Production controlled executor, continuation fork/save/restore and capability rebinding remain C02 obligations.",
        "Production binder ownership, lifecycle/failure isolation and real native/controlled differential execution remain unimplemented.",
        "Runtime callback/manual equivalence, driver ownership, cancellation races and event retry behavior require actual provider conformance tests."
      ]
    },
    {
      "id": "runtime",
      "claim": "Loaders provide execution; binder attaches a compatible contract to an existing Instance with exclusive driving authority.",
      "status": "conditional",
      "assumptions": [
        "Admitted program preserves TS semantics; inner mutable state is complete and isolated.",
        "GameContract handlers are pure and value-isolated; program/contract pairing is correct.",
        "Provider enforces lifecycle, exclusive binding and fork/restore laws in docs/protocol.md.",
        "Callback driving obeys lease, explicit reply/pause, cancellation, late-return and boundary rules; host bindings are not snapshotted."
      ],
      "argument": "evidence/C01/boundary-migration-review.md",
      "evidence": [
        "tests/contracts/basegame-types.ts",
        "docs/protocol.md"
      ],
      "openObligations": [
        "Production controlled executor, continuation fork/save/restore and capability rebinding remain C02 obligations.",
        "Production binder ownership, lifecycle/failure isolation and real native/controlled differential execution remain unimplemented.",
        "Runtime callback/manual equivalence, driver ownership, cancellation races and event retry behavior require actual provider conformance tests."
      ]
    }
  ],
