  "laws": [
    {
      "id": "core",
      "claim": "Game-neutral Core/Instance execute declared IO; each run accepts at most one reply and preserves acceptance through subsequent failure; optional persistence, branching and capture have separate entrypaths.",
      "status": "conditional",
      "assumptions": [
        "Admitted program execution preserves source semantics and owns complete controlled state.",
        "Contract projections and converters are pure, deterministic and value-isolated; caller pairs the program with its contract.",
        "Provider enforces single-step acceptance, identity, cancellation and lifecycle laws."
      ],
      "argument": "evidence/C01/protocol-freeze-proof.md",
      "evidence": [
        "tests/contracts/player.test.ts",
        "tests/contracts/basegame-types.ts",
        "tests/contracts/instance-types.ts",
        "tests/doudizhu/game.test.ts",
        "docs/protocol.md",
        "evidence/C01/convergence-acceptance.md"
      ],
      "openObligations": [
        "C02/C03 verify production controlled execution, admission and full continuation persistence.",
        "Production binder and capture providers implement the documented ownership, isolation and resource lifecycle laws."
      ]
    },
    {
      "id": "game",
      "claim": "Direct-player requests carry pure action options; a game step returns the exact accepted action or optional session input through subsequent stop states.",
      "status": "conditional",
      "assumptions": [
        "Admitted program execution preserves source semantics and owns complete controlled state.",
        "Contract projections and converters are pure, deterministic and value-isolated; caller pairs the program with its contract.",
        "Provider enforces single-step acceptance, identity, cancellation and lifecycle laws."
      ],
      "argument": "evidence/C01/protocol-freeze-proof.md",
      "evidence": [
        "tests/contracts/player.test.ts",
        "tests/contracts/basegame-types.ts",
        "tests/contracts/instance-types.ts",
        "tests/doudizhu/game.test.ts",
        "docs/protocol.md",
        "evidence/C01/convergence-acceptance.md"
      ],
      "openObligations": [
        "C02/C03 verify production controlled execution, admission and full continuation persistence.",
        "Production binder and capture providers implement the documented ownership, isolation and resource lifecycle laws."
      ]
    },
    {
      "id": "authoring",
      "claim": "The game supplies rules, request ownership, pure observation/event projections and optional session conversion; no generic timing enters actions. Shared finite port declarations constrain request/event roles and SDK input/output; packaged inner methods forward exactly one declared IO call without host control capabilities.",
      "status": "conditional",
      "assumptions": [
        "Admitted program execution preserves source semantics and owns complete controlled state.",
        "Contract projections and converters are pure, deterministic and value-isolated; caller pairs the program with its contract.",
        "Provider enforces single-step acceptance, identity, cancellation and lifecycle laws."
      ],
      "argument": "evidence/C01/protocol-freeze-proof.md",
      "evidence": [
        "tests/contracts/player.test.ts",
        "tests/contracts/basegame-types.ts",
        "tests/contracts/instance-types.ts",
        "tests/doudizhu/game.test.ts",
        "docs/protocol.md",
        "evidence/C01/convergence-acceptance.md",
        "tests/contracts/sdk-types.ts",
        "tests/contracts/sdk.test.ts",
        "packages/game-sdk/src/index.ts"
      ],
      "openObligations": [
        "C02/C03 verify production controlled execution, admission and full continuation persistence.",
        "Production binder and capture providers implement the documented ownership, isolation and resource lifecycle laws."
      ]
    },
    {
      "id": "runtime",
      "claim": "Loading pairs declared programs and caller-supplied game contracts, exposes matching optional capabilities and keeps the default public surface small.",
      "status": "conditional",
      "assumptions": [
        "Admitted program execution preserves source semantics and owns complete controlled state.",
        "Contract projections and converters are pure, deterministic and value-isolated; caller pairs the program with its contract.",
        "Provider enforces single-step acceptance, identity, cancellation and lifecycle laws."
      ],
      "argument": "evidence/C01/protocol-freeze-proof.md",
      "evidence": [
