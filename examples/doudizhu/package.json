{
  "name": "@bear-forge/doudizhu",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "dependencies": {
    "@bear-forge/contracts": "*",
    "zod": "4.6.5",
    "@bear-forge/game-sdk": "*",
    "@bear-forge/card-engine": "*",
    "@bear-forge/training": "*"
  },
  "devDependencies": {
    "@bear-forge/compiler": "*",
    "@bear-forge/runtime-controlled": "*",
    "@bear-forge/session": "*",
    "@bear-forge/experiments": "*",
    "@bear-forge/policies": "*",
    "@bear-forge/analysis": "*",
    "@bear-forge/game-host": "*",
    "@bear-forge/runtime-card": "*",
    "@bear-forge/boundary": "*"
