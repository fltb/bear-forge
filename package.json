{
  "name": "bear-forge",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/boundary",
    "packages/runtime",
    "packages/compiler",
    "packages/runtime-native",
    "packages/runtime-controlled",
    "packages/game-sdk",
    "packages/card-engine",
    "examples/doudizhu",
    "packages/game-host",
    "packages/policies",
    "examples/forge-duel",
    "vendor/effectful/*",
    "packages/experiments",
    "packages/analysis",
    "examples/forge-duel-viewer",
    "packages/cli",
    "examples/resolution",
    "packages/session"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "build:games": "npm run build:runtime && node --experimental-strip-types packages/cli/src/main.ts build:games",
    "experiment": "node --experimental-strip-types packages/cli/src/main.ts experiment",
    "analyze": "node --experimental-strip-types packages/cli/src/main.ts analyze",
    "serve": "node --experimental-strip-types packages/cli/src/main.ts serve",
    "demo": "node --experimental-strip-types packages/cli/src/main.ts demo",
    "build:viewer": "npm run build --workspace @bear-forge/forge-duel-viewer",
    "build:runtime": "npm run build --workspace @bear-forge/runtime-controlled",
    "build": "npm run build:games && npm run build:viewer"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@babel/core": "8.0.7",
    "@babel/generator": "8.0.6",
    "@babel/types": "8.0.6",
    "@babel/parser": "8.0.7"
  }
}
