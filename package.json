{
  "name": "bear-forge",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/boundary",
    "packages/runtime",
    "packages/compiler",
    "packages/runtime-native",
    "packages/runtime-controlled",
    "packages/game-sdk",
    "packages/card-engine",
    "packages/runtime-card",
    "packages/training",
    "examples/doudizhu",
    "examples/sts",
    "packages/game-host",
    "packages/policies",
    "examples/forge-duel",
    "vendor/effectful/*",
    "packages/experiments",
    "packages/analysis",
    "examples/forge-duel-viewer",
    "tools/cli",
    "tools/checks",
    "examples/resolution",
    "packages/session"
  ],
  "scripts": {
    "sts": "node --expose-gc --experimental-strip-types examples/sts/src/cli/sts.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "build:games": "node --experimental-strip-types tools/cli/src/main.ts build:games",
    "experiment": "node --experimental-strip-types tools/cli/src/main.ts experiment",
    "analyze": "node --experimental-strip-types tools/cli/src/main.ts analyze",
    "serve": "node --experimental-strip-types tools/cli/src/main.ts serve",
    "demo": "node --experimental-strip-types tools/cli/src/main.ts demo",
    "build:viewer": "npm run build --workspace @bear-forge/forge-duel-viewer",
    "build:runtime": "npm run build --workspace @bear-forge/runtime-controlled",
    "build": "npm run build:runtime && npm run build:games && npm run build:viewer",
    "doudizhu:weights": "uv run --frozen --project examples/doudizhu python examples/doudizhu/src/training/fetch_pretrained.py",
    "doudizhu:training": "node --experimental-strip-types examples/doudizhu/src/training/cli.ts",
    "doudizhu:experiment": "node --experimental-strip-types examples/doudizhu/src/experiment/cli.ts",
    "card": "node --experimental-strip-types tools/cli/src/main.ts card:run",
    "training:setup": "uv sync --frozen --project packages/training --python 3.14",
    "training": "node --experimental-strip-types tools/cli/src/training.ts",
    "evaluate": "node --experimental-strip-types tools/cli/src/main.ts evaluate",
    "sts:tui": "node --experimental-strip-types examples/sts/src/cli/sts-tui.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@babel/core": "8.0.7",
    "@babel/generator": "8.0.6",
    "@babel/types": "8.0.6",
    "@babel/parser": "8.0.7"
  }
}
