    "test:probability": "node --experimental-strip-types --test tests/probability.test.ts tests/probability-cursor.test.ts tests/rules-layout.test.ts tests/rules-modules.test.ts tests/architecture.test.ts tests/rules-schema.test.ts"
  },
  "dependencies": {
    "@bear-forge/contracts": "*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@bear-forge/compiler": "*",
    "@bear-forge/runtime-controlled": "*"
  }
}
